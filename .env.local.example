# Configuración local. Copia este archivo como .env.local.
#
# Docker publica PostgreSQL en 5433 para no interferir con una instalación
# existente en el puerto estándar 5432.
DATABASE_URL=postgresql://contractlens:contractlens@localhost:5433/contractlens
DATABASE_SSL=false

# Necesaria para subir contratos, chat y comparaciones reales. El seed local no
# la utiliza, por lo que los endpoints de lectura funcionan sin consumir cuota.
GEMINI_API_KEY=

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
