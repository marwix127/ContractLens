# Backend en Render — configura estas variables desde el panel del servicio.

# Copia la URL agrupada (pooled) de Neon. Debe conservar `sslmode=require`.
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cadena de modelos con fallback (opcional). Si el primero se agota (429) o se
# satura (503), se pasa al siguiente. Por defecto:
# gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Render inyecta PORT automáticamente. Este valor sirve como fallback local.
PORT=3000

NODE_ENV=production

# Origen permitido por CORS: URL pública del frontend, sin barra final.
FRONTEND_URL=https://contract-lens-mwx.vercel.app

# Protecciones de la demo pública. Son opcionales; estos son los valores por
# defecto y pueden ajustarse sin cambiar el código.
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=100
MAX_PDF_TEXT_CHARS=300000
MAX_QUESTION_CHARS=2000
MAX_AI_CONCURRENCY=3
MAX_AI_CONCURRENCY_PER_IP=1
RATE_LIMIT_CONTRACTS_PER_15_MIN=120
RATE_LIMIT_UPLOADS_PER_HOUR=3
RATE_LIMIT_AI_PER_HOUR=15
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=10
RATE_LIMIT_AI_GLOBAL_PER_DAY=100

# Seguro por defecto: en el despliegue público solo se listan las muestras.
EXPOSE_ALL_CONTRACTS=false
