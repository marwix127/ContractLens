# Backend en Koyeb — configura estas variables desde el panel del servicio.

# Copia la URL agrupada (pooled) de Neon. Debe conservar `sslmode=require`.
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cadena de modelos con fallback (opcional). Si el primero se agota (429) o se
# satura (503), se pasa al siguiente. Por defecto:
# gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Koyeb inyecta PORT automáticamente. Este valor sirve como fallback local.
PORT=3000

NODE_ENV=production

# Origen permitido por CORS: URL pública del frontend, sin barra final.
FRONTEND_URL=https://contract-lens-mwx.vercel.app
